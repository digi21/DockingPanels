<Window
    x:Class="DockingGallery.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docking="using:Digi21.WinUI.Docking"
    xmlns:local="using:DockingGallery"
    Title="Docking Gallery">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Padding="8,4"
            Orientation="Horizontal"
            Spacing="8">
            <Button Click="OnNewDocument" Content="New Document" />
            <Button Click="OnPreviewDocument" Content="Preview Document" />
            <Button Click="OnPinDocument" Content="Pin Active Document" />
            <Button Click="OnCloseDocuments" Content="Close All But Pinned" />
            <Button Click="OnReopenSolutionExplorer" Content="Reopen Solution Explorer" />
            <Button Click="OnReopenOutput" Content="Reopen Output" />
            <Button Click="OnFloatOutput" Content="Float Output" />
            <Button Click="OnDockFloating" Content="Dock Floating" />
            <Button Click="OnSaveLayout" Content="Save Layout" />
            <Button
                x:Name="LoadLayoutButton"
                Click="OnLoadLayout"
                Content="Load Layout"
                IsEnabled="False" />
            <Button Click="OnToggleTheme" Content="Toggle Theme" />
            <TextBlock
                x:Name="EventLog"
                VerticalAlignment="Center"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <docking:DockSite
            x:Name="DockSite"
            Grid.Row="1"
            WindowActivated="OnWindowEvent"
            WindowClosed="OnWindowEvent"
            WindowOpened="OnWindowEvent">
            <docking:SplitContainer Orientation="Horizontal">

                <docking:ToolWindowContainer x:Name="LeftContainer" docking:DockSite.RelativeSize="0.2">
                    <docking:ToolWindow
                        x:Name="SolutionExplorer"
                        Title="Solution Explorer"
                        SerializationId="solutionExplorer">
                        <TreeView>
                            <TreeView.RootNodes>
                                <TreeViewNode Content="DockingPanels" IsExpanded="True">
                                    <TreeViewNode.Children>
                                        <TreeViewNode Content="src" />
                                        <TreeViewNode Content="samples" />
                                        <TreeViewNode Content="tests" />
                                    </TreeViewNode.Children>
                                </TreeViewNode>
                            </TreeView.RootNodes>
                        </TreeView>
                    </docking:ToolWindow>
                    <docking:ToolWindow
                        x:Name="ClassView"
                        Title="Class View"
                        SerializationId="classView">
                        <ListView>
                            <ListViewItem Content="DockSite" />
                            <ListViewItem Content="ToolWindow" />
                            <ListViewItem Content="SplitContainer" />
                        </ListView>
                    </docking:ToolWindow>
                </docking:ToolWindowContainer>

                <docking:SplitContainer
                    x:Name="InnerSplit"
                    docking:DockSite.RelativeSize="0.55"
                    Orientation="Vertical">

                    <docking:DocumentHost x:Name="Documents" docking:DockSite.RelativeSize="0.7">
                        <docking:DocumentContainer>
                            <docking:DocumentWindow
                                x:Name="ReadmeDocument"
                                Title="README.md"
                                SerializationId="readme">
                                <TextBox
                                    AcceptsReturn="True"
                                    BorderThickness="0"
                                    Text="# Digi21.WinUI.Docking&#x0a;&#x0a;Drag this tab to another position, split the area, or pull it out."
                                    TextWrapping="Wrap" />
                            </docking:DocumentWindow>
                            <docking:DocumentWindow
                                x:Name="ProgramDocument"
                                Title="Program.cs"
                                SerializationId="program">
                                <TextBox
                                    AcceptsReturn="True"
                                    BorderThickness="0"
                                    FontFamily="Consolas"
                                    Text="var app = new App();&#x0a;app.Run();"
                                    TextWrapping="Wrap" />
                            </docking:DocumentWindow>
                        </docking:DocumentContainer>
                    </docking:DocumentHost>

                    <docking:ToolWindowContainer x:Name="BottomContainer" docking:DockSite.RelativeSize="0.3">
                        <docking:ToolWindow
                            x:Name="Output"
                            Title="Output"
                            SerializationId="output">
                            <TextBlock
                                Margin="8"
                                Text="Build started...&#x0a;Build succeeded." />
                        </docking:ToolWindow>
                        <docking:ToolWindow
                            Title="Error List"
                            SerializationId="errorList">
                            <TextBlock Margin="8" Text="0 Errors, 0 Warnings" />
                        </docking:ToolWindow>
                    </docking:ToolWindowContainer>

                </docking:SplitContainer>

                <docking:ToolWindowContainer x:Name="RightContainer" docking:DockSite.RelativeSize="0.25">
                    <!--
                        The trace is read while the other panels are being dragged around, so it is
                        the one panel here that stays docked: CanAutoHide takes its pin button away
                        and refuses the operation from code as well.
                    -->
                    <docking:ToolWindow
                        x:Name="EventTrace"
                        CanAutoHide="False"
                        Title="Event Trace"
                        SerializationId="eventTrace">
                        <local:EventTracePanel x:Name="Trace" />
                    </docking:ToolWindow>
                </docking:ToolWindowContainer>

            </docking:SplitContainer>
        </docking:DockSite>
    </Grid>

</Window>
