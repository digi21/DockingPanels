<UserControl
    x:Class="DockingGallery.EventTracePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:DockingGallery">

    <Grid Padding="8" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:ItemsRepeater x:Name="ScenarioButtons">
            <controls:ItemsRepeater.Layout>
                <controls:UniformGridLayout
                    ItemsStretch="Fill"
                    MinColumnSpacing="4"
                    MinItemWidth="84"
                    MinRowSpacing="4" />
            </controls:ItemsRepeater.Layout>
        </controls:ItemsRepeater>

        <Border
            Grid.Row="1"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <ScrollViewer x:Name="TraceScroller" Padding="6,4">
                <controls:ItemsRepeater ItemsSource="{x:Bind Entries}">
                    <controls:ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="local:TraceEntry">
                            <TextBlock
                                FontFamily="Consolas"
                                FontSize="12"
                                FontWeight="{x:Bind Weight}"
                                Text="{x:Bind Line}"
                                TextWrapping="Wrap" />
                        </DataTemplate>
                    </controls:ItemsRepeater.ItemTemplate>
                </controls:ItemsRepeater>
            </ScrollViewer>
        </Border>

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            Spacing="8">
            <Button Click="OnClear" Content="Clear" />
            <TextBlock
                x:Name="Status"
                VerticalAlignment="Center"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>

</UserControl>
