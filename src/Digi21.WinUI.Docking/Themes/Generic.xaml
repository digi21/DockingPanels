<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docking="using:Digi21.WinUI.Docking"
    xmlns:primitives="using:Digi21.WinUI.Docking.Primitives">

    <!--
        The brushes and metrics these templates reference live in Themes/DockingResources.xaml,
        merged into Application.Resources by DockingThemeResources so that an application can
        override any of them. Defining them here instead would make them unoverridable: a key
        found in the same dictionary as the template that uses it wins over the application's.
    -->

    <Style BasedOn="{StaticResource DefaultDockSiteStyle}" TargetType="docking:DockSite" />
    <Style BasedOn="{StaticResource DefaultWorkspaceStyle}" TargetType="docking:Workspace" />
    <Style BasedOn="{StaticResource DefaultDockSplitterStyle}" TargetType="primitives:DockSplitter" />
    <Style BasedOn="{StaticResource DefaultToolWindowStyle}" TargetType="docking:ToolWindow" />
    <Style BasedOn="{StaticResource DefaultToolWindowContainerStyle}" TargetType="docking:ToolWindowContainer" />
    <Style BasedOn="{StaticResource DefaultDocumentHostStyle}" TargetType="docking:DocumentHost" />
    <Style BasedOn="{StaticResource DefaultDocumentWindowStyle}" TargetType="docking:DocumentWindow" />
    <Style BasedOn="{StaticResource DefaultDocumentContainerStyle}" TargetType="docking:DocumentContainer" />
    <Style BasedOn="{StaticResource DefaultDocumentTabItemStyle}" TargetType="primitives:DocumentTabItem" />
    <Style BasedOn="{StaticResource DefaultToolWindowTitleBarStyle}" TargetType="primitives:ToolWindowTitleBar" />
    <Style BasedOn="{StaticResource DefaultToolWindowTabItemStyle}" TargetType="primitives:ToolWindowTabItem" />
    <Style BasedOn="{StaticResource DefaultFloatingWindowRootStyle}" TargetType="primitives:FloatingWindowRoot" />
    <Style BasedOn="{StaticResource DefaultFloatingWindowCaptionStyle}" TargetType="primitives:FloatingWindowCaption" />
    <Style BasedOn="{StaticResource DefaultDockGuideStyle}" TargetType="primitives:DockGuide" />
    <Style BasedOn="{StaticResource DefaultDockGuidePanelStyle}" TargetType="primitives:DockGuidePanel" />
    <Style BasedOn="{StaticResource DefaultAutoHideTabStripStyle}" TargetType="primitives:AutoHideTabStrip" />
    <Style BasedOn="{StaticResource DefaultAutoHideTabItemStyle}" TargetType="primitives:AutoHideTabItem" />
    <Style BasedOn="{StaticResource DefaultAutoHideFlyoutStyle}" TargetType="primitives:AutoHideFlyout" />

    <Style x:Key="DefaultDockSiteStyle" TargetType="docking:DockSite">
        <Setter Property="Background" Value="{ThemeResource DockingSiteBackgroundBrush}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="docking:DockSite">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter
                            x:Name="PART_LayoutRoot"
                            Grid.Row="1"
                            Grid.Column="1"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Child}" />
                        <primitives:AutoHideTabStrip
                            x:Name="PART_AutoHideStripTop"
                            Grid.Row="0"
                            Grid.Column="1"
                            Edge="Top"
                            Visibility="Collapsed" />
                        <primitives:AutoHideTabStrip
                            x:Name="PART_AutoHideStripLeft"
                            Grid.Row="1"
                            Grid.Column="0"
                            Edge="Left"
                            Visibility="Collapsed" />
                        <primitives:AutoHideTabStrip
                            x:Name="PART_AutoHideStripRight"
                            Grid.Row="1"
                            Grid.Column="2"
                            Edge="Right"
                            Visibility="Collapsed" />
                        <primitives:AutoHideTabStrip
                            x:Name="PART_AutoHideStripBottom"
                            Grid.Row="2"
                            Grid.Column="1"
                            Edge="Bottom"
                            Visibility="Collapsed" />
                        <Canvas
                            x:Name="PART_Overlay"
                            Grid.RowSpan="3"
                            Grid.ColumnSpan="3">
                            <Rectangle
                                x:Name="PART_DockPreview"
                                IsHitTestVisible="False"
                                Fill="{ThemeResource DockingDropPreviewFillBrush}"
                                Opacity="{ThemeResource DockingDropPreviewOpacity}"
                                RadiusX="4"
                                RadiusY="4"
                                Stroke="{ThemeResource DockingDropPreviewStrokeBrush}"
                                StrokeThickness="1"
                                Visibility="Collapsed" />
                            <primitives:DockGuidePanel
                                x:Name="PART_CenterGuides"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                            <primitives:DockGuide
                                x:Name="PART_EdgeGuideLeft"
                                IsHitTestVisible="False"
                                Side="Left"
                                Visibility="Collapsed" />
                            <primitives:DockGuide
                                x:Name="PART_EdgeGuideTop"
                                IsHitTestVisible="False"
                                Side="Top"
                                Visibility="Collapsed" />
                            <primitives:DockGuide
                                x:Name="PART_EdgeGuideRight"
                                IsHitTestVisible="False"
                                Side="Right"
                                Visibility="Collapsed" />
                            <primitives:DockGuide
                                x:Name="PART_EdgeGuideBottom"
                                IsHitTestVisible="False"
                                Side="Bottom"
                                Visibility="Collapsed" />
                            <primitives:AutoHideFlyout x:Name="PART_AutoHideFlyout" Visibility="Collapsed" />
                            <Border
                                x:Name="PART_DragGhost"
                                IsHitTestVisible="False"
                                Padding="12,6"
                                Background="{ThemeResource DockingDragGhostBackgroundBrush}"
                                BorderBrush="{ThemeResource DockingDragGhostBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Visibility="Collapsed">
                                <TextBlock
                                    x:Name="PART_DragGhostText"
                                    Foreground="{ThemeResource DockingDragGhostForegroundBrush}"
                                    Style="{ThemeResource DockingTitleTextStyle}" />
                            </Border>
                        </Canvas>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultFloatingWindowRootStyle" TargetType="primitives:FloatingWindowRoot">
        <Setter Property="Background" Value="{ThemeResource DockingFloatingWindowBackgroundBrush}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:FloatingWindowRoot">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <primitives:FloatingWindowCaption x:Name="PART_Caption" Visibility="Collapsed" />
                        <ContentPresenter
                            x:Name="PART_LayoutRoot"
                            Grid.Row="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Content="{TemplateBinding Child}" />
                        <Canvas
                            x:Name="PART_Overlay"
                            Grid.Row="0"
                            Grid.RowSpan="2">
                            <Rectangle
                                x:Name="PART_DockPreview"
                                IsHitTestVisible="False"
                                Fill="{ThemeResource DockingDropPreviewFillBrush}"
                                Opacity="{ThemeResource DockingDropPreviewOpacity}"
                                RadiusX="4"
                                RadiusY="4"
                                Stroke="{ThemeResource DockingDropPreviewStrokeBrush}"
                                StrokeThickness="1"
                                Visibility="Collapsed" />
                            <primitives:DockGuidePanel
                                x:Name="PART_CenterGuides"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />
                            <primitives:DockGuide
                                x:Name="PART_EdgeGuideLeft"
                                IsHitTestVisible="False"
                                Side="Left"
                                Visibility="Collapsed" />
                            <primitives:DockGuide
                                x:Name="PART_EdgeGuideTop"
                                IsHitTestVisible="False"
                                Side="Top"
                                Visibility="Collapsed" />
                            <primitives:DockGuide
                                x:Name="PART_EdgeGuideRight"
                                IsHitTestVisible="False"
                                Side="Right"
                                Visibility="Collapsed" />
                            <primitives:DockGuide
                                x:Name="PART_EdgeGuideBottom"
                                IsHitTestVisible="False"
                                Side="Bottom"
                                Visibility="Collapsed" />
                            <Border
                                x:Name="PART_DragGhost"
                                IsHitTestVisible="False"
                                Padding="12,6"
                                Background="{ThemeResource DockingDragGhostBackgroundBrush}"
                                BorderBrush="{ThemeResource DockingDragGhostBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Visibility="Collapsed">
                                <TextBlock
                                    x:Name="PART_DragGhostText"
                                    Foreground="{ThemeResource DockingDragGhostForegroundBrush}"
                                    Style="{ThemeResource DockingTitleTextStyle}" />
                            </Border>
                        </Canvas>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultFloatingWindowCaptionStyle" TargetType="primitives:FloatingWindowCaption">
        <Setter Property="Height" Value="{ThemeResource DockingCaptionHeight}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="{ThemeResource DockingCaptionBackgroundBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource DockingCaptionForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:FloatingWindowCaption">
                    <Grid Padding="8,0,4,0" Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="PART_Title"
                            VerticalAlignment="Center"
                            Foreground="{TemplateBinding Foreground}"
                            Style="{ThemeResource DockingTitleTextStyle}"
                            TextTrimming="CharacterEllipsis" />
                        <Button
                            x:Name="PART_CloseButton"
                            Grid.Column="1"
                            Width="24"
                            Height="24"
                            Padding="0"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{TemplateBinding Foreground}"
                            IsTabStop="False">
                            <FontIcon
                                FontFamily="{ThemeResource DockingIconFontFamily}"
                                FontSize="{ThemeResource DockingIconFontSize}"
                                Glyph="{ThemeResource DockingCloseGlyph}" />
                        </Button>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultWorkspaceStyle" TargetType="docking:Workspace">
        <Setter Property="Background" Value="{ThemeResource DockingPaneBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DockingPaneBorderBrush}" />
        <Setter Property="BorderThickness" Value="{ThemeResource DockingPaneBorderThickness}" />
        <Setter Property="CornerRadius" Value="{ThemeResource DockingPaneCornerRadius}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="docking:Workspace">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultToolWindowStyle" TargetType="docking:ToolWindow">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="docking:ToolWindow">
                    <ContentPresenter
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultToolWindowContainerStyle" TargetType="docking:ToolWindowContainer">
        <Setter Property="Background" Value="{ThemeResource DockingPaneBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DockingPaneBorderBrush}" />
        <Setter Property="BorderThickness" Value="{ThemeResource DockingPaneBorderThickness}" />
        <Setter Property="CornerRadius" Value="{ThemeResource DockingPaneCornerRadius}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="docking:ToolWindowContainer">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <primitives:ToolWindowTitleBar x:Name="PART_TitleBar" />
                            <ContentPresenter x:Name="PART_ContentHost" Grid.Row="1" />
                            <StackPanel
                                x:Name="PART_TabStrip"
                                Grid.Row="2"
                                Orientation="Horizontal"
                                Spacing="2"
                                Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultDocumentHostStyle" TargetType="docking:DocumentHost">
        <Setter Property="Background" Value="{ThemeResource DockingDocumentHostBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DockingPaneBorderBrush}" />
        <Setter Property="BorderThickness" Value="{ThemeResource DockingPaneBorderThickness}" />
        <Setter Property="CornerRadius" Value="{ThemeResource DockingPaneCornerRadius}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="docking:DocumentHost">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter
                            x:Name="PART_LayoutRoot"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Content="{TemplateBinding Child}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultDocumentWindowStyle" TargetType="docking:DocumentWindow">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="docking:DocumentWindow">
                    <ContentPresenter
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultDocumentContainerStyle" TargetType="docking:DocumentContainer">
        <Setter Property="Background" Value="{ThemeResource DockingPaneBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DockingPaneBorderBrush}" />
        <Setter Property="BorderThickness" Value="{ThemeResource DockingPaneBorderThickness}" />
        <Setter Property="CornerRadius" Value="{ThemeResource DockingPaneCornerRadius}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="docking:DocumentContainer">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border
                                Background="{ThemeResource DockingTabStripBackgroundBrush}"
                                BorderBrush="{ThemeResource DockingTabStripBorderBrush}"
                                BorderThickness="0,0,0,1">
                                <ScrollViewer
                                    HorizontalScrollBarVisibility="Auto"
                                    HorizontalScrollMode="Auto"
                                    VerticalScrollBarVisibility="Disabled"
                                    VerticalScrollMode="Disabled">
                                    <StackPanel
                                        x:Name="PART_TabStrip"
                                        Orientation="Horizontal"
                                        Spacing="2" />
                                </ScrollViewer>
                            </Border>
                            <ContentPresenter x:Name="PART_ContentHost" Grid.Row="1" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultDocumentTabItemStyle" TargetType="primitives:DocumentTabItem">
        <Setter Property="Height" Value="{ThemeResource DockingDocumentTabHeight}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="{ThemeResource DockingTabBackgroundBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource DockingTabForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:DocumentTabItem">
                    <Grid
                        x:Name="Root"
                        Padding="10,0,4,0"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{ThemeResource DockingDocumentTabCornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="PART_CloseButton.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed" />
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="SelectionStates">
                                <VisualState x:Name="Unselected" />
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource DockingDocumentTabSelectedBackgroundBrush}" />
                                        <Setter Target="PART_CloseButton.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Active">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource DockingDocumentTabActiveBackgroundBrush}" />
                                        <Setter Target="PART_Title.Foreground" Value="{ThemeResource DockingDocumentTabActiveForegroundBrush}" />
                                        <Setter Target="PART_CloseButton.Foreground" Value="{ThemeResource DockingDocumentTabActiveForegroundBrush}" />
                                        <Setter Target="PART_CloseButton.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="PART_Title"
                            VerticalAlignment="Center"
                            Foreground="{TemplateBinding Foreground}"
                            Style="{ThemeResource DockingTabTextStyle}"
                            TextTrimming="CharacterEllipsis" />
                        <Button
                            x:Name="PART_CloseButton"
                            Grid.Column="1"
                            Width="20"
                            Height="20"
                            Padding="0"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{TemplateBinding Foreground}"
                            IsTabStop="False"
                            Opacity="0">
                            <FontIcon
                                FontFamily="{ThemeResource DockingIconFontFamily}"
                                FontSize="{ThemeResource DockingIconFontSize}"
                                Glyph="{ThemeResource DockingCloseGlyph}" />
                        </Button>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultToolWindowTitleBarStyle" TargetType="primitives:ToolWindowTitleBar">
        <Setter Property="Height" Value="{ThemeResource DockingTitleBarHeight}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="{ThemeResource DockingTitleBarBackgroundBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource DockingTitleBarForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:ToolWindowTitleBar">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" Padding="8,0,4,0">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="ActivationStates">
                                <VisualState x:Name="Inactive" />
                                <VisualState x:Name="Active">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource DockingTitleBarActiveBackgroundBrush}" />
                                        <Setter Target="PART_Title.Foreground" Value="{ThemeResource DockingTitleBarActiveForegroundBrush}" />
                                        <Setter Target="PART_CloseButton.Foreground" Value="{ThemeResource DockingTitleBarActiveForegroundBrush}" />
                                        <Setter Target="PART_PinButton.Foreground" Value="{ThemeResource DockingTitleBarActiveForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="PART_Title"
                            VerticalAlignment="Center"
                            Foreground="{TemplateBinding Foreground}"
                            Style="{ThemeResource DockingTitleTextStyle}"
                            TextTrimming="CharacterEllipsis" />
                        <Button
                            x:Name="PART_PinButton"
                            Grid.Column="1"
                            Width="24"
                            Height="24"
                            Padding="0"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{TemplateBinding Foreground}"
                            IsTabStop="False">
                            <FontIcon
                                FontFamily="{ThemeResource DockingIconFontFamily}"
                                FontSize="{ThemeResource DockingIconFontSize}"
                                Glyph="{ThemeResource DockingPinGlyph}" />
                        </Button>
                        <Button
                            x:Name="PART_CloseButton"
                            Grid.Column="2"
                            Width="24"
                            Height="24"
                            Padding="0"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{TemplateBinding Foreground}"
                            IsTabStop="False">
                            <FontIcon
                                FontFamily="{ThemeResource DockingIconFontFamily}"
                                FontSize="{ThemeResource DockingIconFontSize}"
                                Glyph="{ThemeResource DockingCloseGlyph}" />
                        </Button>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultToolWindowTabItemStyle" TargetType="primitives:ToolWindowTabItem">
        <Setter Property="Height" Value="{ThemeResource DockingToolWindowTabHeight}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="{ThemeResource DockingTabBackgroundBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource DockingTabForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:ToolWindowTabItem">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" Padding="8,0">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource DockingTabPointerOverBackgroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource DockingTabPressedBackgroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="SelectionStates">
                                <VisualState x:Name="Unselected" />
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="SelectionIndicator.Visibility" Value="Visible" />
                                        <Setter Target="PART_Title.Foreground" Value="{ThemeResource DockingTabSelectedForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <TextBlock
                            x:Name="PART_Title"
                            VerticalAlignment="Center"
                            Foreground="{TemplateBinding Foreground}"
                            Style="{ThemeResource DockingTabTextStyle}" />
                        <Rectangle
                            x:Name="SelectionIndicator"
                            Height="2"
                            VerticalAlignment="Bottom"
                            Fill="{ThemeResource DockingTabSelectionIndicatorBrush}"
                            RadiusX="1"
                            RadiusY="1"
                            Visibility="Collapsed" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultAutoHideTabStripStyle" TargetType="primitives:AutoHideTabStrip">
        <Setter Property="Background" Value="{ThemeResource DockingAutoHideTabStripBackgroundBrush}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:AutoHideTabStrip">
                    <Grid x:Name="PART_Items" Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultAutoHideTabItemStyle" TargetType="primitives:AutoHideTabItem">
        <Setter Property="Background" Value="{ThemeResource DockingAutoHideTabBackgroundBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource DockingAutoHideTabForegroundBrush}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:AutoHideTabItem">
                    <Grid
                        x:Name="Root"
                        Padding="10,6"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{ThemeResource DockingAutoHideTabBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <TextBlock
                            x:Name="PART_Title"
                            VerticalAlignment="Center"
                            Foreground="{TemplateBinding Foreground}"
                            Style="{ThemeResource DockingTabTextStyle}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultAutoHideFlyoutStyle" TargetType="primitives:AutoHideFlyout">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:AutoHideFlyout">
                    <Border
                        Background="{ThemeResource DockingFlyoutBackgroundBrush}"
                        BorderBrush="{ThemeResource DockingFlyoutBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource DockingFlyoutCornerRadius}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <primitives:ToolWindowTitleBar x:Name="PART_TitleBar" />
                            <ContentPresenter x:Name="PART_ContentHost" Grid.Row="1" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultDockGuideStyle" TargetType="primitives:DockGuide">
        <Setter Property="Width" Value="{ThemeResource DockingGuideSize}" />
        <Setter Property="Height" Value="{ThemeResource DockingGuideSize}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Foreground" Value="{ThemeResource DockingGuideForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:DockGuide">
                    <Grid
                        x:Name="Root"
                        Background="{ThemeResource DockingGuideBackgroundBrush}"
                        BorderBrush="{ThemeResource DockingGuideBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{ThemeResource DockingGuideCornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="HotStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="Hot">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource DockingGuideHotBackgroundBrush}" />
                                        <Setter Target="PART_Icon.Foreground" Value="{ThemeResource DockingGuideHotForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <FontIcon
                            x:Name="PART_Icon"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{ThemeResource DockingIconFontFamily}"
                            FontSize="{ThemeResource DockingGuideIconFontSize}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultDockGuidePanelStyle" TargetType="primitives:DockGuidePanel">
        <Setter Property="Width" Value="{ThemeResource DockingGuideClusterSize}" />
        <Setter Property="Height" Value="{ThemeResource DockingGuideClusterSize}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:DockGuidePanel">
                    <Grid>
                        <primitives:DockGuide
                            x:Name="PART_LeftGuide"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Side="Left" />
                        <primitives:DockGuide
                            x:Name="PART_TopGuide"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Side="Top" />
                        <primitives:DockGuide
                            x:Name="PART_CenterGuide"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsCenter="True" />
                        <primitives:DockGuide
                            x:Name="PART_RightGuide"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Side="Right" />
                        <primitives:DockGuide
                            x:Name="PART_BottomGuide"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Side="Bottom" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DefaultDockSplitterStyle" TargetType="primitives:DockSplitter">
        <!--  Transparent, not unset: the splitter needs a filled background to be hit-testable.  -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:DockSplitter">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="GripLine.Fill" Value="{ThemeResource DockingSplitterPointerOverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="GripLine.Fill" Value="{ThemeResource DockingSplitterPressedBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Rectangle x:Name="GripLine" Fill="{ThemeResource DockingSplitterBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
