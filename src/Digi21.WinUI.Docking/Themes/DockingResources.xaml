<!--
    Every brush and metric the docking chrome is painted with. Recoloring the library means
    redefining these keys in the application's resources; retemplating is only needed to change
    the shape of a control, not its colors.

    This dictionary is merged into Application.Resources (see DockingThemeResources), and not
    into Themes/Generic.xaml, on purpose: a key defined in the same dictionary as the template
    that uses it wins over anything the application declares, which would make the keys
    unoverridable. Merged at the bottom of the collection, everything the application merges
    later, and every key it declares directly, takes precedence over these defaults.

    The three theme dictionaries are what makes an override follow the theme: a StaticResource
    inside one resolves against that theme's system brushes, so the same key gives a different
    color in light, dark and high contrast.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <StaticResource x:Key="DockingSiteBackgroundBrush" ResourceKey="LayerFillColorDefaultBrush" />
            <StaticResource x:Key="DockingFloatingWindowBackgroundBrush" ResourceKey="LayerFillColorDefaultBrush" />
            <StaticResource x:Key="DockingPaneBackgroundBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="DockingPaneBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <StaticResource x:Key="DockingDocumentHostBackgroundBrush" ResourceKey="SolidBackgroundFillColorTertiaryBrush" />
            <StaticResource x:Key="DockingTabStripBackgroundBrush" ResourceKey="LayerFillColorDefaultBrush" />
            <StaticResource x:Key="DockingTabStripBorderBrush" ResourceKey="DividerStrokeColorDefaultBrush" />

            <StaticResource x:Key="DockingTitleBarBackgroundBrush" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="DockingTitleBarForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="DockingTitleBarActiveBackgroundBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="DockingTitleBarActiveForegroundBrush" ResourceKey="TextOnAccentFillColorPrimaryBrush" />

            <StaticResource x:Key="DockingCaptionBackgroundBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="DockingCaptionForegroundBrush" ResourceKey="TextOnAccentFillColorPrimaryBrush" />

            <StaticResource x:Key="DockingTabBackgroundBrush" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="DockingTabForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="DockingTabPointerOverBackgroundBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="DockingTabPressedBackgroundBrush" ResourceKey="SubtleFillColorTertiaryBrush" />
            <StaticResource x:Key="DockingTabSelectedForegroundBrush" ResourceKey="AccentTextFillColorPrimaryBrush" />
            <StaticResource x:Key="DockingTabSelectionIndicatorBrush" ResourceKey="AccentFillColorDefaultBrush" />

            <StaticResource x:Key="DockingDocumentTabSelectedBackgroundBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="DockingDocumentTabActiveBackgroundBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="DockingDocumentTabActiveForegroundBrush" ResourceKey="TextOnAccentFillColorPrimaryBrush" />

            <StaticResource x:Key="DockingSplitterBrush" ResourceKey="DividerStrokeColorDefaultBrush" />
            <StaticResource x:Key="DockingSplitterPointerOverBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="DockingSplitterPressedBrush" ResourceKey="AccentFillColorTertiaryBrush" />

            <StaticResource x:Key="DockingGuideBackgroundBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="DockingGuideBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <StaticResource x:Key="DockingGuideForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="DockingGuideHotBackgroundBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="DockingGuideHotForegroundBrush" ResourceKey="TextOnAccentFillColorPrimaryBrush" />

            <StaticResource x:Key="DockingDropPreviewFillBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="DockingDropPreviewStrokeBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="DockingDragGhostBackgroundBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="DockingDragGhostBorderBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="DockingDragGhostForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />

            <StaticResource x:Key="DockingAutoHideTabStripBackgroundBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="DockingAutoHideTabBackgroundBrush" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="DockingAutoHideTabBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <StaticResource x:Key="DockingAutoHideTabForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />

            <StaticResource x:Key="DockingFlyoutBackgroundBrush" ResourceKey="SolidBackgroundFillColorSecondaryBrush" />
            <StaticResource x:Key="DockingFlyoutBorderBrush" ResourceKey="SurfaceStrokeColorDefaultBrush" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <StaticResource x:Key="DockingSiteBackgroundBrush" ResourceKey="LayerFillColorDefaultBrush" />
            <StaticResource x:Key="DockingFloatingWindowBackgroundBrush" ResourceKey="LayerFillColorDefaultBrush" />
            <StaticResource x:Key="DockingPaneBackgroundBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="DockingPaneBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <StaticResource x:Key="DockingDocumentHostBackgroundBrush" ResourceKey="SolidBackgroundFillColorTertiaryBrush" />
            <StaticResource x:Key="DockingTabStripBackgroundBrush" ResourceKey="LayerFillColorDefaultBrush" />
            <StaticResource x:Key="DockingTabStripBorderBrush" ResourceKey="DividerStrokeColorDefaultBrush" />

            <StaticResource x:Key="DockingTitleBarBackgroundBrush" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="DockingTitleBarForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="DockingTitleBarActiveBackgroundBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="DockingTitleBarActiveForegroundBrush" ResourceKey="TextOnAccentFillColorPrimaryBrush" />

            <StaticResource x:Key="DockingCaptionBackgroundBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="DockingCaptionForegroundBrush" ResourceKey="TextOnAccentFillColorPrimaryBrush" />

            <StaticResource x:Key="DockingTabBackgroundBrush" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="DockingTabForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="DockingTabPointerOverBackgroundBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="DockingTabPressedBackgroundBrush" ResourceKey="SubtleFillColorTertiaryBrush" />
            <StaticResource x:Key="DockingTabSelectedForegroundBrush" ResourceKey="AccentTextFillColorPrimaryBrush" />
            <StaticResource x:Key="DockingTabSelectionIndicatorBrush" ResourceKey="AccentFillColorDefaultBrush" />

            <StaticResource x:Key="DockingDocumentTabSelectedBackgroundBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="DockingDocumentTabActiveBackgroundBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="DockingDocumentTabActiveForegroundBrush" ResourceKey="TextOnAccentFillColorPrimaryBrush" />

            <StaticResource x:Key="DockingSplitterBrush" ResourceKey="DividerStrokeColorDefaultBrush" />
            <StaticResource x:Key="DockingSplitterPointerOverBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="DockingSplitterPressedBrush" ResourceKey="AccentFillColorTertiaryBrush" />

            <StaticResource x:Key="DockingGuideBackgroundBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="DockingGuideBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <StaticResource x:Key="DockingGuideForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="DockingGuideHotBackgroundBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="DockingGuideHotForegroundBrush" ResourceKey="TextOnAccentFillColorPrimaryBrush" />

            <StaticResource x:Key="DockingDropPreviewFillBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="DockingDropPreviewStrokeBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="DockingDragGhostBackgroundBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="DockingDragGhostBorderBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="DockingDragGhostForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />

            <StaticResource x:Key="DockingAutoHideTabStripBackgroundBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="DockingAutoHideTabBackgroundBrush" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="DockingAutoHideTabBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <StaticResource x:Key="DockingAutoHideTabForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />

            <StaticResource x:Key="DockingFlyoutBackgroundBrush" ResourceKey="SolidBackgroundFillColorSecondaryBrush" />
            <StaticResource x:Key="DockingFlyoutBorderBrush" ResourceKey="SurfaceStrokeColorDefaultBrush" />
        </ResourceDictionary>

        <!--
            High contrast keeps the same aliases: the WinUI fill and text brushes below already
            resolve to the user's system colors there, so the chrome follows the contrast theme
            without a separate palette.
        -->
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="DockingSiteBackgroundBrush" ResourceKey="LayerFillColorDefaultBrush" />
            <StaticResource x:Key="DockingFloatingWindowBackgroundBrush" ResourceKey="LayerFillColorDefaultBrush" />
            <StaticResource x:Key="DockingPaneBackgroundBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="DockingPaneBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <StaticResource x:Key="DockingDocumentHostBackgroundBrush" ResourceKey="SolidBackgroundFillColorTertiaryBrush" />
            <StaticResource x:Key="DockingTabStripBackgroundBrush" ResourceKey="LayerFillColorDefaultBrush" />
            <StaticResource x:Key="DockingTabStripBorderBrush" ResourceKey="DividerStrokeColorDefaultBrush" />

            <StaticResource x:Key="DockingTitleBarBackgroundBrush" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="DockingTitleBarForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="DockingTitleBarActiveBackgroundBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="DockingTitleBarActiveForegroundBrush" ResourceKey="TextOnAccentFillColorPrimaryBrush" />

            <StaticResource x:Key="DockingCaptionBackgroundBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="DockingCaptionForegroundBrush" ResourceKey="TextOnAccentFillColorPrimaryBrush" />

            <StaticResource x:Key="DockingTabBackgroundBrush" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="DockingTabForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="DockingTabPointerOverBackgroundBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="DockingTabPressedBackgroundBrush" ResourceKey="SubtleFillColorTertiaryBrush" />
            <StaticResource x:Key="DockingTabSelectedForegroundBrush" ResourceKey="AccentTextFillColorPrimaryBrush" />
            <StaticResource x:Key="DockingTabSelectionIndicatorBrush" ResourceKey="AccentFillColorDefaultBrush" />

            <StaticResource x:Key="DockingDocumentTabSelectedBackgroundBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="DockingDocumentTabActiveBackgroundBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="DockingDocumentTabActiveForegroundBrush" ResourceKey="TextOnAccentFillColorPrimaryBrush" />

            <StaticResource x:Key="DockingSplitterBrush" ResourceKey="DividerStrokeColorDefaultBrush" />
            <StaticResource x:Key="DockingSplitterPointerOverBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="DockingSplitterPressedBrush" ResourceKey="AccentFillColorTertiaryBrush" />

            <StaticResource x:Key="DockingGuideBackgroundBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="DockingGuideBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <StaticResource x:Key="DockingGuideForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="DockingGuideHotBackgroundBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="DockingGuideHotForegroundBrush" ResourceKey="TextOnAccentFillColorPrimaryBrush" />

            <StaticResource x:Key="DockingDropPreviewFillBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="DockingDropPreviewStrokeBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="DockingDragGhostBackgroundBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="DockingDragGhostBorderBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="DockingDragGhostForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />

            <StaticResource x:Key="DockingAutoHideTabStripBackgroundBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="DockingAutoHideTabBackgroundBrush" ResourceKey="SubtleFillColorTransparentBrush" />
            <StaticResource x:Key="DockingAutoHideTabBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <StaticResource x:Key="DockingAutoHideTabForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />

            <StaticResource x:Key="DockingFlyoutBackgroundBrush" ResourceKey="SolidBackgroundFillColorSecondaryBrush" />
            <StaticResource x:Key="DockingFlyoutBorderBrush" ResourceKey="SurfaceStrokeColorDefaultBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!--
        Metrics are the same in every theme. The guide sizes are read back by the drag code from
        the elements themselves, so changing them moves the guides and their hit areas alike.
    -->
    <x:Double x:Key="DockingTitleBarHeight">32</x:Double>
    <x:Double x:Key="DockingCaptionHeight">32</x:Double>
    <x:Double x:Key="DockingDocumentTabHeight">30</x:Double>
    <x:Double x:Key="DockingPinnedTabStripMaxWidth">400</x:Double>
    <x:Double x:Key="DockingProvisionalTabStripMaxWidth">240</x:Double>
    <x:Double x:Key="DockingToolWindowTabHeight">28</x:Double>
    <x:Double x:Key="DockingGuideSize">40</x:Double>
    <x:Double x:Key="DockingGuideClusterSize">128</x:Double>
    <x:Double x:Key="DockingDropPreviewOpacity">0.3</x:Double>
    <Thickness x:Key="DockingPaneBorderThickness">1</Thickness>
    <CornerRadius x:Key="DockingPaneCornerRadius">0</CornerRadius>
    <CornerRadius x:Key="DockingDocumentTabCornerRadius">4,4,0,0</CornerRadius>
    <CornerRadius x:Key="DockingGuideCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="DockingFlyoutCornerRadius">4</CornerRadius>

    <!--
        The splitter metrics are read from here by the layout code, since a splitter is sized by
        the panel that arranges it rather than by its own template: the band is how much room the
        splitter takes between two panes, the grip is the line drawn inside it.
    -->
    <x:Double x:Key="DockingSplitterThickness">6</x:Double>
    <x:Double x:Key="DockingSplitterGripThickness">1</x:Double>

    <!--
        How long an auto-hidden panel takes to slide out from its edge, in milliseconds. Zero makes
        panels appear at once without turning the animation off across the application. Windows
        still has the last word: with animation effects off, nothing slides whatever this says.
    -->
    <x:Double x:Key="DockingAutoHideSlideMilliseconds">150</x:Double>

    <!--
        Icons. The glyphs are Segoe Fluent Icons code points; replacing the font family means
        replacing the glyphs with the corresponding code points of the new font.
    -->
    <StaticResource x:Key="DockingIconFontFamily" ResourceKey="SymbolThemeFontFamily" />
    <x:Double x:Key="DockingIconFontSize">10</x:Double>
    <x:Double x:Key="DockingGuideIconFontSize">14</x:Double>
    <x:String x:Key="DockingCloseGlyph">&#xE8BB;</x:String>

    <!--
        The pin glyphs of a tool window's title bar, which auto-hides it and pins it back, and the
        pin glyphs of a document tab, which fix it at the head of the strip. Two different things
        that Visual Studio also draws with a pushpin: keep them apart when redefining either.
    -->
    <x:String x:Key="DockingPinGlyph">&#xE718;</x:String>
    <x:String x:Key="DockingUnpinGlyph">&#xE77A;</x:String>
    <x:String x:Key="DockingTabPinGlyph">&#xE718;</x:String>
    <x:String x:Key="DockingTabUnpinGlyph">&#xE77A;</x:String>
    <x:String x:Key="DockingGuideCenterGlyph">&#xE8A9;</x:String>
    <x:String x:Key="DockingGuideLeftGlyph">&#xE76B;</x:String>
    <x:String x:Key="DockingGuideTopGlyph">&#xE70E;</x:String>
    <x:String x:Key="DockingGuideRightGlyph">&#xE76C;</x:String>
    <x:String x:Key="DockingGuideBottomGlyph">&#xE70D;</x:String>

    <!--
        Text. Both alias the WinUI caption style, so the chrome can be restyled on its own instead
        of by overriding CaptionTextBlockStyle, which would reach the whole application.
    -->
    <StaticResource x:Key="DockingTitleTextStyle" ResourceKey="CaptionTextBlockStyle" />
    <StaticResource x:Key="DockingTabTextStyle" ResourceKey="CaptionTextBlockStyle" />

    <!--
        Names. What the chrome buttons are called: a screen reader reads these, they are the
        tooltips, and they are what UI Automation finds a button by. They are keys like everything
        else here, so an application that is not in English redefines them along with the rest.
        The pin button takes whichever of the two matches what clicking it would do.
    -->
    <x:String x:Key="DockingCloseButtonName">Close</x:String>
    <x:String x:Key="DockingAutoHideButtonName">Auto-hide</x:String>
    <x:String x:Key="DockingDockButtonName">Dock</x:String>

    <!--
        The document tab's own pin button and the commands of its context menu. "Pin" here fixes the
        tab at the head of the strip; auto-hiding is what the two names above are for.
    -->
    <x:String x:Key="DockingPinTabButtonName">Pin tab</x:String>
    <x:String x:Key="DockingUnpinTabButtonName">Unpin tab</x:String>
    <x:String x:Key="DockingKeepTabOpenName">Keep open</x:String>
    <x:String x:Key="DockingCloseAllTabsName">Close all tabs</x:String>
    <x:String x:Key="DockingCloseAllButPinnedTabsName">Close all but pinned</x:String>
    <x:String x:Key="DockingCloseAllButThisTabName">Close all but this</x:String>

</ResourceDictionary>
